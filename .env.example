# ====================================================
# ShopFast E-Commerce - Environment Configuration
# ====================================================

# 1. PostgreSQL 16 Database
POSTGRES_USER=shopfast_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=shopfast_db

# 2. JWT Security Secrets (Minimum 32 characters, generate using `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_min_32_characters_random_string_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_random_string_here

# 3. AI Customer Support Agent (F01) - DeepSeek
# Dán API key DeepSeek của bạn vào đây (ví dụ: sk-xxxx):
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
