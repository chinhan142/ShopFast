# Environment Mode
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://shopfast_user:shopfast_password@localhost:5432/shopfast_db?schema=public

# JWT Security Secrets (Must be set, NO fallback allowed in codebase)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_REFRESH_EXPIRATION=7d

# Redis Configuration (For Caching, Throttling & Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Provider Configuration (DeepSeek / OpenAI Compatible / Gemini)
AI_PROVIDER=deepseek
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
