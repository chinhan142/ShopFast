generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

enum TicketCategory {
  ORDER_INQUIRY
  PRODUCT_STOCK
  PAYMENT_ISSUE
  RETURN_REFUND
  GENERAL_SUPPORT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  fullName     String
  phone        String?
  role         Role      @default(CUSTOMER)
  refreshToken String?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders  Order[]
  tickets Ticket[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid())
  sku         String      @unique
  name        String
  slug        String      @unique
  description String?
  price       Float
  stock       Int         @default(0)
  brand       String?
  imageUrl    String?
  isActive    Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@index([price])
  @@index([brand])
  @@map("products")
}

model Order {
  id              String      @id @default(uuid())
  orderCode       String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          OrderStatus @default(PENDING)
  totalAmount     Float
  shippingAddress String
  phone           String
  notes           String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Float
  subtotal  Float

  @@map("order_items")
}

model Ticket {
  id          String         @id @default(uuid())
  ticketCode  String         @unique
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    TicketCategory @default(GENERAL_SUPPORT)
  status      TicketStatus   @default(OPEN)
  subject     String
  description String
  aiSummary   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@map("tickets")
}
